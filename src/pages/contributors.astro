---
import AsciiDivider from "@/components/ascii-divider.astro";
import ContributorsContent from "@/components/contributors-content.astro";
import ContributorsContentSkeleton from "@/components/contributors-content-skeleton.astro";
import BaseLayout from "@/layouts/base-layout.astro";

export const prerender = true;
---

<BaseLayout
  title="Contributors"
  description="Everyone who has contributed code to Shadcn Labs — the people behind the registries, tools, and templates."
>
  <AsciiDivider />

  <section class="view-container" id="contributors">
    <h2>
      <a href="#contributors" class="view-container-title">Contributors</a>
    </h2>

    <ContributorsContent server:defer>
      <div slot="fallback" role="status">
        <span class="sr-only">Loading contributors…</span>
        <ContributorsContentSkeleton />
      </div>
    </ContributorsContent>
  </section>
</BaseLayout>
