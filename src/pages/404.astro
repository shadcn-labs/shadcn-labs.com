---
import { NotFoundHero } from "@/components/not-found/not-found-hero";
import BaseLayout from "@/layouts/base-layout.astro";
import { getContributors } from "@/lib/github";

export const prerender = true;

// Fetched once at build time; the page states the snapshot date. A failed
// fetch renders the page without the contributor background.
const contributors = await getContributors();
const logins = contributors?.map((person) => person.login) ?? [];
const snapshotAt = new Date().toISOString();
---

<BaseLayout
  title="Page not found"
  description="This page could not be found."
  noindex
  nofollow
>
  <NotFoundHero client:load logins={logins} snapshotAt={snapshotAt} />
</BaseLayout>
