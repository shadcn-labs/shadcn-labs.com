---
import { Check, Copy, Download } from "@lucide/astro";
import AsciiDivider from "@/components/ascii-divider.astro";
import { FontFamilyTabs } from "@/components/font-family-tabs";
import { LovedBy, LovedByLogos } from "@/components/font/loved-by";
import { buttonVariants } from "@/components/ui/button";
import { TWEET_STATS } from "@/data/goeist-social";
import BaseLayout from "@/layouts/base-layout.astro";

const GITHUB_URL = "https://github.com/shadcn-labs/goeist-font";
const RELEASES_URL = `${GITHUB_URL}/releases/latest`;
const NPM_URL = "https://www.npmjs.com/package/goeist";
const LICENSE_URL = `${GITHUB_URL}/blob/main/OFL.txt`;

const FAMILIES = [
  {
    description:
      "Geist's proportions, spacing and OpenType features, with every exposed corner and stroke ending rounded. For interfaces, body copy and display sizes where Geist should feel a little warmer.",
    face: "face-sans",
    id: "sans",
    meta: "100–900 · italic",
    name: "Goeist Sans",
    sample: "Soft corners, sturdy letters.",
    tag: "sans",
  },
  {
    description:
      "The monospaced partner. Every corner is rounded as if drawn with one round tool, so stroke ends, slabs and dots become semicircles while widths stay fixed. Keeps Geist Mono's coding ligatures.",
    face: "face-mono",
    id: "mono",
    meta: "100–900 · ligatures",
    name: "Goeist Mono",
    sample: "const soft = (a) => a + 1;",
    tag: "mono",
  },
  {
    description:
      "A soft display serif. Saw-toothed serifs end in half-rounds and cut terminals in circular arcs, while hairlines and contrast stay fine. Includes Geist Serif's Element Shape axis.",
    face: "face-serif",
    id: "serif",
    meta: "400 · four dot shapes",
    name: "Goeist Serif",
    sample: "Editorial, with a wink.",
    tag: "serif",
  },
];

const WEIGHTS = [
  { name: "thin", value: 100 },
  { name: "extralight", value: 200 },
  { name: "light", value: 300 },
  { name: "regular", value: 400 },
  { name: "medium", value: 500 },
  { name: "semibold", value: 600 },
  { name: "bold", value: 700 },
  { name: "extrabold", value: 800 },
  { name: "black", value: 900 },
];

const CHARSETS = [
  { chars: "ABCDEFGHIJKLMNOPQRSTUVWXYZ", label: "uppercase" },
  { chars: "abcdefghijklmnopqrstuvwxyz", label: "lowercase" },
  { chars: "0123456789", label: "figures" },
  { chars: ".,:;!?'\"()[]{}–—…&*#@", label: "punctuation" },
  { chars: "+-×÷=≠≈≤≥∞§¶†‡©®™→←↑↓", label: "symbols" },
];

const SHAPES = [
  { label: "regular", value: 0 },
  { label: "square", value: 25 },
  { label: "triangle", value: 50 },
  { label: "heart", value: 100 },
];

const INSTALL_SNIPPET = `npm i goeist`;
const NEXT_SNIPPET = `import { GoeistSans } from "goeist/font/sans";
import { GoeistMono } from "goeist/font/mono";
import { GoeistSerif } from "goeist/font/serif";`;
const CSS_SNIPPET = `@import "goeist/sans.css";
@import "goeist/mono.css";
@import "goeist/serif.css";`;
const LIGATURES = `const sum = (a, b) => a + b; if (a != b && i <= n) { return a => b; }`;
---

<BaseLayout
  title="Goeist"
  description="Goeist is a rounded take on Geist — a free, open-source type family for interfaces, code and display. Sans, Mono and Serif by Shadcn Labs."
>
  <div class="view-container my-6 flex flex-wrap items-center justify-between gap-3">
    <FontFamilyTabs client:load />

    <a
      href={RELEASES_URL}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Get the font"
      class={buttonVariants({
        size: "default",
        className: "max-sm:w-8 max-sm:px-0",
      })}
    >
      <Download class="size-4" aria-hidden="true" />
      <span class="max-sm:hidden">Get the font</span>
    </a>
  </div>

  <section id="overview" class="view-container">
    <div class="relative pt-2">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute top-2 right-0 left-0 text-[clamp(5rem,30vw,14rem)]"
      >
        <div class="border-foreground/15 absolute inset-x-0 top-[0.025em] border-t"></div>
        <div class="border-foreground/12 absolute inset-x-0 top-[0.21em] border-t"></div>
        <div class="border-foreground/15 absolute inset-x-0 top-[0.755em] border-t"></div>
      </div>
      <h2
        id="overview-heading"
        class="face-sans relative z-10 -ml-2 text-[clamp(5rem,30vw,14rem)] font-medium leading-[0.8] tracking-[-0.05em]"
      >
        Goeist<span id="overview-period">.</span>
      </h2>
    </div>

    <p
      class="face-sans max-w-xl pt-4 text-xl leading-tight tracking-[-0.02em] sm:text-2xl"
    >
      A rounded take on Geist. Sans, Mono and Serif keep Geist's proportions,
      spacing and OpenType features while softening every exposed corner and
      stroke ending, built for interfaces, code and display sizes.
    </p>

  </section>

  <AsciiDivider />

  <section id="weights" class="view-container-wide py-12">
    <div class="mx-auto max-w-2xl">
      <h2>
        <a href="#weights" class="view-container-title">Weights</a>
      </h2>
      <p class="text-muted-foreground text-sm">
        Goeist Sans and Goeist Mono run the full gamut from Thin to Black, each
        with a matching true italic. One variable file covers every step in
        between &mdash; no faux bold.
      </p>
    </div>

    <div class="mt-8 grid grid-cols-3 gap-x-4 gap-y-8 sm:grid-cols-5 lg:grid-cols-9">
      {
        WEIGHTS.map((weight) => (
          <div>
            <div
              class="face-sans text-4xl leading-none tracking-[-0.03em] sm:text-5xl"
              style={`font-weight:${weight.value}`}
            >
              Aa
            </div>
            <p class="text-muted-foreground mt-2 text-xs">{weight.name}</p>
            <p class="text-muted-foreground text-xs tabular-nums">
              {weight.value}
            </p>
          </div>
        ))
      }
    </div>

    <div class="relative mt-12 overflow-hidden rounded-2xl border border-border/60 bg-muted/30 p-10 dark:bg-[#212017]">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute left-1/2 top-1/2 h-[160%] w-px -translate-x-1/2 -translate-y-1/2 rotate-[24deg] bg-primary/30"
      ></div>
      <div class="face-sans relative flex flex-wrap items-center justify-center gap-x-10 gap-y-2 text-[clamp(3rem,12vw,8rem)] font-medium leading-none tracking-[-0.04em]">
        <span>Aa</span>
        <span class="face-mono">Aa</span>
        <span class="face-serif">Aa</span>
      </div>
      <p class="text-muted-foreground relative mt-6 text-center text-sm">
        One family, three voices. The diagonal guide crosses Sans, Mono and
        Serif &mdash; every exposed corner and stroke ending, rounded.
      </p>
    </div>
  </section>

  <AsciiDivider />

  <section id="tester" class="view-container-wide">
    <!-- Rotation / Bar Adjusters -->
    <div id="sliders-grid" class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Weight Slider -->
      <div id="weight-slider-wrapper" class="flex flex-col gap-2">
        <div class="flex items-center justify-between face-sans text-xs text-muted-foreground">
          <span>Weight</span>
          <span id="slider-weight-val" class="font-medium text-foreground">400</span>
        </div>
        <div
          class="rotary-slider relative flex h-11 w-full select-none touch-none cursor-ew-resize items-center overflow-hidden rounded-xl border border-border/60 bg-muted/50 dark:bg-[#212017] dark:border-transparent px-3 shadow-inner"
          data-slider="weight"
          data-min="100"
          data-max="900"
          data-step="10"
          data-value="400"
          role="slider"
          aria-label="Weight"
          aria-valuemin="100"
          aria-valuemax="900"
          aria-valuenow="400"
          tabindex="0"
        >
          <!-- Center indicator line & dot -->
          <div class="pointer-events-none absolute left-1/2 top-1.5 bottom-1.5 z-20 w-[2px] -translate-x-1/2 rounded-full bg-primary">
            <div class="absolute -top-1 left-1/2 size-2 -translate-x-1/2 rounded-full bg-primary"></div>
          </div>
          <!-- Track viewport with gradient mask -->
          <div class="pointer-events-none relative z-10 size-full overflow-hidden [mask-image:linear-gradient(to_right,transparent_0%,black_18%,black_82%,transparent_100%)]">
            <div class="slider-track-wrap absolute inset-0"></div>
          </div>
        </div>
      </div>

      <!-- Size Slider -->
      <div class="flex flex-col gap-2">
        <div class="flex items-center justify-between face-sans text-xs text-muted-foreground">
          <span>Size</span>
          <span id="slider-size-val" class="font-medium text-foreground">60px</span>
        </div>
        <div
          class="rotary-slider relative flex h-11 w-full select-none touch-none cursor-ew-resize items-center overflow-hidden rounded-xl border border-border/60 bg-muted/50 dark:bg-[#212017] dark:border-transparent px-3 shadow-inner"
          data-slider="size"
          data-min="24"
          data-max="120"
          data-step="1"
          data-value="60"
          role="slider"
          aria-label="Size"
          aria-valuemin="24"
          aria-valuemax="120"
          aria-valuenow="60"
          tabindex="0"
        >
          <div class="pointer-events-none absolute left-1/2 top-1.5 bottom-1.5 z-20 w-[2px] -translate-x-1/2 rounded-full bg-primary">
            <div class="absolute -top-1 left-1/2 size-2 -translate-x-1/2 rounded-full bg-primary"></div>
          </div>
          <div class="pointer-events-none relative z-10 size-full overflow-hidden [mask-image:linear-gradient(to_right,transparent_0%,black_18%,black_82%,transparent_100%)]">
            <div class="slider-track-wrap absolute inset-0"></div>
          </div>
        </div>
      </div>

      <!-- Letter Spacing Slider -->
      <div class="flex flex-col gap-2">
        <div class="flex items-center justify-between face-sans text-xs text-muted-foreground">
          <span>Letter spacing</span>
          <span id="slider-spacing-val" class="font-medium text-foreground">-0.03em</span>
        </div>
        <div
          class="rotary-slider relative flex h-11 w-full select-none touch-none cursor-ew-resize items-center overflow-hidden rounded-xl border border-border/60 bg-muted/50 dark:bg-[#212017] dark:border-transparent px-3 shadow-inner"
          data-slider="spacing"
          data-min="-5"
          data-max="15"
          data-step="0.5"
          data-value="-3"
          role="slider"
          aria-label="Letter spacing"
          aria-valuemin="-5"
          aria-valuemax="15"
          aria-valuenow="-3"
          tabindex="0"
        >
          <div class="pointer-events-none absolute left-1/2 top-1.5 bottom-1.5 z-20 w-[2px] -translate-x-1/2 rounded-full bg-primary">
            <div class="absolute -top-1 left-1/2 size-2 -translate-x-1/2 rounded-full bg-primary"></div>
          </div>
          <div class="pointer-events-none relative z-10 size-full overflow-hidden [mask-image:linear-gradient(to_right,transparent_0%,black_18%,black_82%,transparent_100%)]">
            <div class="slider-track-wrap absolute inset-0"></div>
          </div>
        </div>
      </div>

      <!-- Line Height Slider -->
      <div class="flex flex-col gap-2">
        <div class="flex items-center justify-between face-sans text-xs text-muted-foreground">
          <span>Line height</span>
          <span id="slider-lineHeight-val" class="font-medium text-foreground">1.20</span>
        </div>
        <div
          class="rotary-slider relative flex h-11 w-full select-none touch-none cursor-ew-resize items-center overflow-hidden rounded-xl border border-border/60 bg-muted/50 dark:bg-[#212017] dark:border-transparent px-3 shadow-inner"
          data-slider="lineHeight"
          data-min="90"
          data-max="180"
          data-step="5"
          data-value="120"
          role="slider"
          aria-label="Line height"
          aria-valuemin="0.9"
          aria-valuemax="1.8"
          aria-valuenow="1.2"
          tabindex="0"
        >
          <div class="pointer-events-none absolute left-1/2 top-1.5 bottom-1.5 z-20 w-[2px] -translate-x-1/2 rounded-full bg-primary">
            <div class="absolute -top-1 left-1/2 size-2 -translate-x-1/2 rounded-full bg-primary"></div>
          </div>
          <div class="pointer-events-none relative z-10 size-full overflow-hidden [mask-image:linear-gradient(to_right,transparent_0%,black_18%,black_82%,transparent_100%)]">
            <div class="slider-track-wrap absolute inset-0"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap items-center gap-2">
      <button
        id="tester-italic"
        type="button"
        aria-pressed="false"
        class="seg-btn"
      >
        Italic
      </button>

      <div
        id="tester-shapes-wrap"
        class="hidden items-center gap-1 rounded-full bg-muted/60 p-1"
      >
        {
          SHAPES.map((shape) => (
            <button
              type="button"
              data-shape={shape.value}
              class="seg-btn"
              aria-pressed={shape.value === 0 ? "true" : "false"}
            >
              {shape.label}
            </button>
          ))
        }
      </div>

      <button id="tester-reset" type="button" class="seg-btn">Reset</button>
    </div>

    <div
      class="relative flex min-h-80 w-full flex-col justify-center overflow-hidden rounded-xl border border-border/60 bg-muted/30 dark:bg-[#212017] p-0 text-foreground dark:text-[#f5f4ef] sm:min-h-96"
    >
      <div
        id="specimen"
        contenteditable="true"
        role="textbox"
        aria-multiline="true"
        aria-label="Type tester specimen text"
        spellcheck="false"
        class="face-sans relative z-10 w-full text-left cursor-text text-4xl font-normal tracking-[-0.03em] outline-none sm:text-6xl [overflow-wrap:anywhere]"
      ><div class="specimen-line px-4 sm:px-6">Soft corners,</div><div class="specimen-line px-4 sm:px-6 pt-4">sharper ideas.</div></div>
    </div>
  </section>

  <AsciiDivider />

  <section id="loved-by" class="view-container-wide py-12">
    <div class="mx-auto max-w-2xl">
      <h2>
        <a href="#loved-by" class="view-container-title">
          Loved by designers &amp; engineers
        </a>
      </h2>
      <p class="text-muted-foreground text-sm">
        {TWEET_STATS.likes} likes, {TWEET_STATS.reposts} reposts and{" "}
        {TWEET_STATS.replies} replies on the launch — from the people building
        the tools you already use.
      </p>
    </div>

    <div class="mt-10">
      <LovedByLogos client:visible />
    </div>

    <div class="mt-12">
      <LovedBy client:visible />
    </div>
  </section>

  <AsciiDivider />

  <section id="features" class="view-container">
    <h2>
      <a href="#features" class="view-container-title">Features</a>
    </h2>
    <p class="text-muted-foreground text-sm">
      Everything Geist does well — rounded off. Variable weights, OpenType
      features and optical niceties, free under the SIL Open Font License.
    </p>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div class="rounded-xl border border-border/60 bg-muted/30 p-5 dark:bg-[#212017]">
        <div class="face-sans flex items-baseline gap-4 text-5xl leading-none tracking-[-0.03em]">
          <span class="font-thin">Aa</span>
          <span class="font-semibold">Aa</span>
          <span class="font-black">Aa</span>
        </div>
        <h3 class="mt-5 text-sm font-medium">Variable weight</h3>
        <p class="text-muted-foreground mt-1 text-xs">
          Nine weights, 100&ndash;900, in a single variable file &mdash; no faux
          bold.
        </p>
      </div>

      <div class="rounded-xl border border-border/60 bg-muted/30 p-5 dark:bg-[#212017]">
        <div class="face-sans text-5xl italic leading-none tracking-[-0.03em]">
          Aa
        </div>
        <h3 class="mt-5 text-sm font-medium">True italic</h3>
        <p class="text-muted-foreground mt-1 text-xs">
          Drawn, not slanted &mdash; matching the rounded outlines.
        </p>
      </div>

      <div class="rounded-xl border border-border/60 bg-muted/30 p-5 dark:bg-[#212017]">
        <div class="face-mono overflow-hidden text-2xl leading-tight">
          =&gt; != &lt;= &amp;&amp;
        </div>
        <h3 class="mt-5 text-sm font-medium">Coding ligatures</h3>
        <p class="text-muted-foreground mt-1 text-xs">
          <code class="font-mono">&gt;=</code>, <code class="font-mono">!=</code>,{" "}
          <code class="font-mono">&lt;=</code> and <code class="font-mono">&amp;&amp;</code>{" "}
          in Goeist Mono.
        </p>
      </div>

      <div class="rounded-xl border border-border/60 bg-muted/30 p-5 dark:bg-[#212017]">
        <div class="face-sans text-2xl leading-none tabular-nums">1,248.31</div>
        <h3 class="mt-5 text-sm font-medium">Tabular figures</h3>
        <p class="text-muted-foreground mt-1 text-xs">
          Aligned numerals that line up in tables and data.
        </p>
      </div>

      <div class="rounded-xl border border-border/60 bg-muted/30 p-5 dark:bg-[#212017]">
        <div class="face-mono text-3xl leading-none">O0 Il1</div>
        <h3 class="mt-5 text-sm font-medium">Slashed zero</h3>
        <p class="text-muted-foreground mt-1 text-xs">
          Unambiguous 0 vs O for terminals, code and forms.
        </p>
      </div>

      <div class="rounded-xl border border-border/60 bg-muted/30 p-5 dark:bg-[#212017]">
        <div class="face-sans text-5xl leading-none tracking-[-0.03em]">ao</div>
        <h3 class="mt-5 text-sm font-medium">Rounded terminals</h3>
        <p class="text-muted-foreground mt-1 text-xs">
          Every exposed corner and stroke ending, softened.
        </p>
      </div>
    </div>
  </section>

  <AsciiDivider />

  <section id="specs" class="view-container">
    <h2>
      <a href="#specs" class="view-container-title">Technical specifications</a>
    </h2>
    <p class="text-muted-foreground text-sm">
      The numbers behind the family.
    </p>

    <div class="overflow-hidden rounded-xl border border-border">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border bg-muted/40 text-muted-foreground">
            <th class="px-4 py-2 text-left font-normal">Family</th>
            <th class="px-4 py-2 text-left font-normal">Weights</th>
            <th class="px-4 py-2 text-left font-normal">Italic</th>
            <th class="px-4 py-2 text-left font-normal">Features</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-border">
            <td class="px-4 py-3 font-medium">Goeist Sans</td>
            <td class="px-4 py-3">100&ndash;900</td>
            <td class="px-4 py-3">Yes</td>
            <td class="px-4 py-3">Variable + static</td>
          </tr>
          <tr class="border-b border-border">
            <td class="px-4 py-3 font-medium">Goeist Mono</td>
            <td class="px-4 py-3">100&ndash;900</td>
            <td class="px-4 py-3">Yes</td>
            <td class="px-4 py-3">Coding ligatures</td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-medium">Goeist Serif</td>
            <td class="px-4 py-3">Variable</td>
            <td class="px-4 py-3">No</td>
            <td class="px-4 py-3">4 dot shapes (ELSH)</td>
          </tr>
        </tbody>
      </table>
    </div>

    <dl class="space-y-0">
      <div class="flex items-center justify-between gap-4 border-b border-border/60 py-2 text-sm">
        <dt class="text-muted-foreground">License</dt>
        <dd>SIL Open Font License 1.1</dd>
      </div>
      <div class="flex items-center justify-between gap-4 border-b border-border/60 py-2 text-sm">
        <dt class="text-muted-foreground">Format</dt>
        <dd>WOFF2 &middot; variable + static</dd>
      </div>
      <div class="flex items-center justify-between gap-4 border-b border-border/60 py-2 text-sm">
        <dt class="text-muted-foreground">OpenType</dt>
        <dd>Tabular figures, slashed zero, fractions, ligatures</dd>
      </div>
      <div class="flex items-center justify-between gap-4 border-b border-border/60 py-2 text-sm">
        <dt class="text-muted-foreground">Design</dt>
        <dd>Rounded variant of Geist</dd>
      </div>
    </dl>
  </section>

  <AsciiDivider />

  <section id="examples" class="view-container-wide py-12">
    <div class="mx-auto max-w-2xl">
      <h2>
        <a href="#examples" class="view-container-title">Examples</a>
      </h2>
      <p class="text-muted-foreground text-sm">
        The same family in the places it's made for &mdash; interfaces, code and
        editorial.
      </p>
    </div>

    <div class="mt-6 space-y-6">
      <div class="overflow-hidden rounded-xl border border-border/60 bg-background">
        <div class="flex items-center gap-2 border-b border-border/60 px-4 py-2.5">
          <span class="size-2.5 rounded-full bg-border"></span>
          <span class="size-2.5 rounded-full bg-border"></span>
          <span class="size-2.5 rounded-full bg-border"></span>
          <span class="text-muted-foreground ml-3 text-xs">analytics.goeist.sh</span>
        </div>
        <div class="flex">
          <aside class="hidden w-44 shrink-0 border-r border-border/60 p-4 md:block">
            <p class="face-sans text-sm font-medium">Goeist Analytics</p>
            <nav class="mt-4 space-y-0.5 text-sm">
              <a class="block rounded-md bg-foreground/5 px-2.5 py-1.5 font-medium">Overview</a>
              <a class="text-muted-foreground block rounded-md px-2.5 py-1.5">Audience</a>
              <a class="text-muted-foreground block rounded-md px-2.5 py-1.5">Sources</a>
              <a class="text-muted-foreground block rounded-md px-2.5 py-1.5">Settings</a>
            </nav>
          </aside>
          <div class="min-w-0 flex-1 p-4 sm:p-6">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="face-sans text-base font-medium">Overview</h3>
              <span class="text-muted-foreground text-xs">Last 30 days</span>
            </div>
            <div class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
              <div class="rounded-lg border border-border/60 p-3">
                <p class="text-muted-foreground text-xs">Visitors</p>
                <p class="face-sans mt-1 text-xl font-medium tabular-nums">12,480</p>
                <p class="mt-0.5 text-xs text-emerald-500">+12.4%</p>
              </div>
              <div class="rounded-lg border border-border/60 p-3">
                <p class="text-muted-foreground text-xs">Page views</p>
