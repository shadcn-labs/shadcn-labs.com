---
import { ArrowUpRight, Check, Download, X } from "@lucide/astro";
import AsciiDivider from "@/components/ascii-divider.astro";
import { FontFamilyTabs } from "@/components/font-family-tabs";
import { FontExamples } from "@/components/font/font-examples";
import { FontDescription } from "@/components/font/font-description";
import { GlyphInspector } from "@/components/font/glyph-inspector";
import { LovedBy, LovedByLogos } from "@/components/font/loved-by";
import { InstallCard } from "@/components/font/install-card";
import { StylisticSets } from "@/components/font/stylistic-sets";
import { TypeTester } from "@/components/font/type-tester";
import { GitHubIcon } from "@/components/icons";
import { buttonVariants } from "@/components/ui/button";
import {
  DOWNLOAD_SIZE,
  DOWNLOAD_URL,
  FONT_VERSION,
  GITHUB_URL,
  LICENSE_URL,
} from "@/data/goeist-font";
import BaseLayout from "@/layouts/base-layout.astro";

const DOWNLOAD_FILE = `Goeist-Family-v${FONT_VERSION}.zip`;

const SPECS = [
  { label: "Name", value: "Goeist" },
  { label: "Families", value: "Sans, Mono, Serif" },
  { label: "Weights", value: "9 (Thin 100 to Black 900), true italics" },
  { label: "Formats", value: "OTF, TTF, variable TTF, WOFF2" },
  { label: "Glyphs", value: "975 (Sans), 1,159 (Mono), 898 (Serif)" },
  {
    label: "Scripts",
    value: "Latin (387 languages), Cyrillic (39) in Sans and Mono",
  },
  {
    label: "OpenType",
    value: "tnum, frac, sups, subs, ordn, case, liga, stylistic sets",
  },
  { label: "Based on", value: "Geist by Vercel and Basement Studio" },
];

const LICENSE_CAN = [
  "Personal and commercial use",
  "Embed on the web with @font-face",
  "Bundle with apps and products",
  "Modify and create derivative fonts",
  "Redistribute freely, no attribution required",
];

const LICENSE_TERMS = [
  "Don't sell the font files on their own",
  "Derivatives must stay under the OFL",
  "Modified versions can't use the name Goeist",
];

const TYPE_CREDITS = [
  { href: "https://github.com/lauridskern/open-runde", name: "Open Runde" },
  { href: "https://github.com/bvvst/intern", name: "Intern" },
  { href: "https://github.com/anaclumos/sunghyun-sans", name: "Sunghyun Sans" },
  {
    href: "https://abcdinamo.com/typefaces/diatype-rounded",
    name: "ABC Diatype Rounded Mono",
  },
  { href: "https://github.com/undercasetype/Fraunces", name: "Fraunces" },
];
---

<BaseLayout
  title="Goeist"
  description="Goeist is a rounded take on Geist — a free, open-source type family for interfaces, code and display. Sans, Mono and Serif by Shadcn Labs."
>
  <div class="view-container my-6 flex flex-wrap items-center justify-between gap-3 space-y-0">
    <FontFamilyTabs client:load />

    <a
      href="#get"
      aria-label="Get the font"
      class={buttonVariants({
        size: "default",
        className: "max-sm:w-8 max-sm:px-0",
      })}
    >
      <Download class="size-4" aria-hidden="true" />
      <span class="max-sm:hidden">Get the font</span>
    </a>
  </div>

  <section id="overview" class="view-container">
    <div class="relative pt-2">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute top-2 right-0 left-0 text-[clamp(4.5rem,24vw,10rem)]"
      >
        <div class="border-foreground/15 absolute inset-x-0 top-[0.025em] border-t"></div>
        <div class="border-foreground/12 absolute inset-x-0 top-[0.21em] border-t"></div>
        <div class="border-foreground/15 absolute inset-x-0 top-[0.755em] border-t"></div>
      </div>
      <h2
        id="overview-heading"
        data-family-face
        class="font-sans relative z-10 -ml-1 text-[clamp(4.5rem,24vw,10rem)] font-medium leading-[0.8] tracking-[-0.05em]"
      >
        Goeist<span id="overview-period">.</span>
      </h2>
    </div>
  </section>

  <AsciiDivider class="text-center" />

  <section id="at-a-glance" class="view-container">
    <h2>
      <a href="#at-a-glance" class="view-container-title">At a glance</a>
    </h2>
    <FontDescription client:visible />
  </section>

  <AsciiDivider class="text-center" />

  <section id="glyphs" class="view-container-wide">
    <h2>
      <a href="#glyphs" class="view-container-title">Glyphs</a>
    </h2>
    <div class="pt-3">
      <GlyphInspector client:visible />
    </div>
  </section>

  <AsciiDivider class="text-center" />

  <section id="stylistic-sets" class="view-container-wide">
    <h2>
      <a href="#stylistic-sets" class="view-container-title">Stylistic sets</a>
    </h2>
    <div class="pt-3">
      <StylisticSets client:visible />
    </div>
  </section>

  <AsciiDivider class="text-center" />

  <section id="examples" class="view-container-wide">
    <h2>
      <a href="#examples" class="view-container-title">Examples</a>
    </h2>
    <div class="pt-3">
      <FontExamples client:visible />
    </div>
  </section>

  <AsciiDivider class="text-center" />

  <section id="tester" class="view-container-wide">
    <h2>
      <a href="#tester" class="view-container-title">Type tester</a>
    </h2>
    <div class="pt-3">
      <TypeTester client:visible />
    </div>
  </section>

  <AsciiDivider class="text-center" />

  <section id="specs" class="view-container">
    <h2>
      <a href="#specs" class="view-container-title">Specs &amp; license</a>
    </h2>

    <dl class="grid grid-cols-1 gap-x-6 gap-y-4 pt-3 sm:grid-cols-2">
      {
        SPECS.map((spec) => (
          <div class="border-border/60 border-t pt-2">
            <dt class="text-muted-foreground text-xs">{spec.label}</dt>
            <dd class="mt-1 text-sm">{spec.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="grid grid-cols-1 gap-3 pt-3 sm:grid-cols-[2fr_3fr]">
      <div class="flex flex-col rounded-xl border border-border bg-muted/30 p-5 dark:bg-[#212017]">
        <p class="text-muted-foreground text-xs">Free forever</p>
        <p class="font-sans mt-1 text-5xl font-medium tracking-[-0.04em]">$0</p>
        <p class="text-muted-foreground mt-1 text-sm">No cost, no catch.</p>
        <a
          class="link-underline mt-auto inline-flex items-center gap-1 pt-6 text-sm"
          href={LICENSE_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          Read the full license
          <ArrowUpRight class="size-3.5" aria-hidden="true" />
        </a>
      </div>

      <div class="rounded-xl border border-border p-5">
        <ul class="space-y-2 text-sm">
          {
            LICENSE_CAN.map((item) => (
              <li class="flex gap-2">
                <Check
                  class="mt-0.5 size-4 shrink-0 text-emerald-500"
                  aria-hidden="true"
                />
                {item}
              </li>
            ))
          }
          {
            LICENSE_TERMS.map((item) => (
              <li class="text-muted-foreground flex gap-2">
                <X class="text-destructive mt-0.5 size-4 shrink-0" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <AsciiDivider class="text-center" />

  <section id="loved-by" class="view-container-wide">
    <h2>
      <a href="#loved-by" class="view-container-title">
        Loved by designers &amp; engineers
      </a>
    </h2>

    <div class="pt-3">
      <LovedByLogos client:visible />
    </div>
    <div class="pt-6">
      <LovedBy client:visible />
    </div>
  </section>

  <AsciiDivider class="text-center" />

  <section id="get" class="view-container pb-6">
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      <div class="cta-panel flex min-h-64 flex-col justify-between gap-6 rounded-2xl border border-border p-6">
        <p
          data-family-face
          class="font-sans text-6xl font-medium leading-none tracking-[-0.05em] sm:text-7xl"
        >
          Goeist.
        </p>
        <p class="text-muted-foreground text-sm">
          A rounded take on Geist.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <a href={DOWNLOAD_URL} aria-label={`Download ${DOWNLOAD_FILE}`} class="cta-card">
          <span class="flex items-center justify-between gap-2 text-sm font-medium">
            Download
            <Download class="size-4" aria-hidden="true" />
          </span>
          <span class="flex items-baseline justify-between gap-2">
            <span class="text-2xl font-medium tracking-[-0.03em] sm:text-3xl">
              Goeist {FONT_VERSION}
            </span>
            <span class="text-muted-foreground shrink-0 text-xs">
              zip &middot; {DOWNLOAD_SIZE}
            </span>
          </span>
        </a>
        <InstallCard client:visible />
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="cta-card">
          <span class="flex items-center justify-between gap-2 text-sm font-medium">
            Source
            <ArrowUpRight class="size-4" aria-hidden="true" />
          </span>
          <span class="flex items-center gap-2 text-2xl font-medium tracking-[-0.03em] sm:text-3xl">
            <GitHubIcon className="size-6" />
            GitHub
          </span>
        </a>
      </div>
    </div>

    <div class="text-muted-foreground space-y-2 pt-3 text-xs">
        <p>
          Designed by{" "}
          <a class="link-underline text-foreground" href="https://github.com/Aniket-508" target="_blank" rel="noopener noreferrer">Aniket Pawar</a>{" "}
          at Shadcn Labs, drawn from{" "}
          <a class="link-underline text-foreground" href="https://github.com/vercel/geist-font" target="_blank" rel="noopener noreferrer">Geist</a>{" "}
          by Vercel and Basement Studio. Rounding inspired by{" "}
          {
            TYPE_CREDITS.map((credit, index) => (
              <>
                <a
                  class="link-underline text-foreground"
                  href={credit.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {credit.name}
                </a>
                {index < TYPE_CREDITS.length - 1 ? ", " : ""}
              </>
            ))
          }{" "}
          and{" "}
          <a
            class="link-underline text-foreground"
            href="https://fontsinuse.com/typefaces/1913/itc-souvenir"
            target="_blank"
            rel="noopener noreferrer"
          >
            ITC Souvenir
          </a>.
        </p>
        <p>
          Goeist is independent, not affiliated with or endorsed by Vercel. ABC
          Diatype and ITC Souvenir are visual references only; none of their
          font data is used.
        </p>
    </div>
  </section>
</BaseLayout>

<style>
  #overview-heading:global(.font-mono) {
    letter-spacing: -0.1em;
  }

  #overview-heading:global(.font-mono) #overview-period {
    display: none;
  }

  .cta-panel {
    background-image: radial-gradient(
      circle at 100% 0%,
      color-mix(in oklab, var(--primary) 16%, transparent),
      transparent 62%
    );
  }

  .cta-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-radius: 1rem;
    background-color: color-mix(in oklab, var(--muted) 50%, transparent);
    padding: 1.25rem;
    transition: background-color 150ms ease;
  }

  :global(.dark) .cta-card {
    border: 1px solid var(--border);
    background-color: #212017;
  }

  .cta-card:hover {
    background-color: var(--muted);
  }
</style>

<script>
  import {
    FONT_FAMILY_EVENT,
    FONT_FAMILY_PARAM,
    isFontFamily,
    setFontFamily,
  } from "@/components/font/use-font-family";

  const FACES = ["font-sans", "font-mono", "font-serif"];

  document.addEventListener(FONT_FAMILY_EVENT, (event) => {
    const family = (event as CustomEvent<{ family?: string }>).detail?.family;

    if (!isFontFamily(family)) {
      return;
    }

    for (const element of document.querySelectorAll("[data-family-face]")) {
      element.classList.remove(...FACES);
      element.classList.add(`font-${family}`);
    }
  });

  // Apply the font family from the URL on first load so deep links like
  // /font?type=serif render the correct family before any interaction.
  const initialFamily = new URLSearchParams(window.location.search).get(
    FONT_FAMILY_PARAM
  );

  if (isFontFamily(initialFamily)) {
    setFontFamily(initialFamily);
  }
</script>
