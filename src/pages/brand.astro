---
import BaseLayout from "@/layouts/base-layout.astro";
import AsciiDivider from "@/components/ascii-divider.astro";
import { Logomark, Logotype } from "@/components/logo";
---

<BaseLayout
  title="Shadcn Labs Brand"
  description="Key elements of the Shadcn Labs visual identity, including the logomark, logotype, and more."
>
  <AsciiDivider />

  <section class="view-container">
    <h2>LOGOMARK</h2>

    <figure class="flex justify-center py-8">
      <Logomark className="h-[70px] w-auto text-foreground" />
    </figure>

    <a href="/shadcn-labs-logomark.svg" download>Download Logomark</a>
  </section>

  <AsciiDivider />

  <section class="view-container">
    <h2>LOGOTYPE</h2>

    <figure class="flex justify-center items-center py-8">
      <Logotype className="h-[20px] w-auto text-foreground" />
    </figure>

    <a href="/shadcn-labs-logotype.svg" download>Download Logotype</a>
  </section>

  <AsciiDivider />

  <section class="view-container">
    <h2>LOGO GUIDELINES</h2>
    <p>
      The project logo format uses the mark at 1x height with a 1x (10px) gap,
      followed by the project name in Geist Medium at -3% letter spacing. Total
      height is 7x.
    </p>
  </section>

  <AsciiDivider />

  <section class="view-container">
    <h2>COLOR PALETTE</h2>

    <div class="grid grid-cols-2 gap-4 py-4 sm:grid-cols-4">
      <div class="space-y-2">
        <div class="h-16 w-full rounded border border-border bg-background">
        </div>
        <p>Background</p>
        <p class="text-muted-foreground">#f5f4ef</p>
      </div>
      <div class="space-y-2">
        <div class="h-16 w-full rounded border border-border bg-foreground">
        </div>
        <p>Foreground</p>
        <p class="text-muted-foreground">#111111</p>
      </div>
      <div class="space-y-2">
        <div class="h-16 w-full rounded border border-border bg-primary"></div>
        <p>Primary</p>
        <p class="text-muted-foreground">#f06292</p>
      </div>
      <div class="space-y-2">
        <div class="h-16 w-full rounded border border-border bg-border"></div>
        <p>Border</p>
        <p class="text-muted-foreground">#e5e5e5</p>
      </div>
    </div>

    <h3 class="pt-2">Dark Mode</h3>
    <div class="grid grid-cols-2 gap-4 py-4 sm:grid-cols-4">
      <div class="space-y-2">
        <div
          class="dark h-16 w-full rounded border border-border bg-background"
        >
        </div>
        <p>Background</p>
        <p class="text-muted-foreground">#070708</p>
      </div>
      <div class="space-y-2">
        <div
          class="dark h-16 w-full rounded border border-border bg-foreground"
        >
        </div>
        <p>Foreground</p>
        <p class="text-muted-foreground">#f5f4ef</p>
      </div>
      <div class="space-y-2">
        <div class="dark h-16 w-full rounded border border-border bg-primary">
        </div>
        <p>Primary</p>
        <p class="text-muted-foreground">#f06292</p>
      </div>
      <div class="space-y-2">
        <div class="dark h-16 w-full rounded border border-border bg-border">
        </div>
        <p>Border</p>
        <p class="text-muted-foreground">#333333</p>
      </div>
    </div>
  </section>

  <AsciiDivider />

  <section class="view-container">
    <h2>TYPOGRAPHY</h2>
    <p>
      Geist Medium with -3% letter spacing. The typeface reinforces the
      technical and developer-focused nature of the brand.
    </p>

    <div class="space-y-4 py-4">
      <div>
        <p class="text-lg font-medium tracking-[-0.03]">Geist Medium</p>
        <p class="text-muted-foreground">
          ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />
          abcdefghijklmnopqrstuvwxyz<br />
          0123456789
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
