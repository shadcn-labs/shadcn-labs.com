---
import { ArrowRight, Check } from "@lucide/astro";
import AsciiDivider from "@/components/ascii-divider.astro";
import { SponsorAnalytics } from "@/components/sponsor-analytics";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import BaseLayout from "@/layouts/base-layout.astro";
import { ROUTES } from "@/constants/routes";
import {
  SPONSORS,
  SPONSOR_TIERS,
  SPONSORSHIP_CONTACT_URL,
  sponsorCheckoutUrl,
} from "@/constants/sponsors";
import type { SponsorTierId } from "@/constants/sponsors";
import { UTM_PARAMS } from "@/constants/site";
import {
  ANALYTICS_CACHE_TTL_SECONDS,
  ANALYTICS_FAILURE_CACHE_TTL_SECONDS,
  getSponsorAnalytics,
} from "@/lib/vercel-analytics";
import { addQueryParams } from "@/lib/url";

// Rendered on demand so the edge cache serves fresh analytics for an hour at a
// time instead of freezing a snapshot into the build.
export const prerender = false;

const { snapshot, stale } = await getSponsorAnalytics();

// Set after the fetch: a failed or stale page gets a short TTL so it recovers
// soon, while a good one is served from the edge for the full TTL plus a day of
// stale-while-revalidate, so Vercel is queried roughly once an hour at most.
if (Astro.cache.enabled) {
  Astro.cache.set(
    stale
      ? { maxAge: ANALYTICS_FAILURE_CACHE_TTL_SECONDS, tags: ["sponsors"] }
      : {
          maxAge: ANALYTICS_CACHE_TTL_SECONDS,
          swr: 86_400,
          tags: ["sponsors"],
        },
  );
}

const formatDay = (value: string): string =>
  new Date(`${value}T00:00:00.000Z`).toLocaleDateString("en-US", {
    day: "numeric",
    month: "short",
    timeZone: "UTC",
  });

// Bigger tiers get bigger blocks, and every tier always keeps one open spot.
const BLOCK_LAYOUT: Record<SponsorTierId, { grid: string; block: string; logo: string }> = {
  diamond: { block: "h-28", grid: "grid-cols-1 sm:grid-cols-2", logo: "max-h-12" },
  gold: { block: "h-24", grid: "grid-cols-2 sm:grid-cols-3", logo: "max-h-9" },
  silver: { block: "h-20", grid: "grid-cols-2 sm:grid-cols-4", logo: "max-h-7" },
};

const tierGroups = SPONSOR_TIERS.map((tier) => ({
  layout: BLOCK_LAYOUT[tier.id],
  sponsors: SPONSORS.filter((sponsor) => sponsor.tier === tier.id),
  tier,
}));
---

<BaseLayout
  title="Sponsors"
  description="Sponsor Shadcn Labs — reach developers across the shadcn/ui ecosystem. Live audience analytics, current sponsors, and sponsorship tiers."
>
  <AsciiDivider />

  <section id="audience" class="view-container">
    <div class="flex items-center justify-between gap-4">
      <h2>
        <a href="#audience" class="view-container-title">AUDIENCE</a>
      </h2>
      {
        snapshot && (
          <p class="text-muted-foreground text-right text-xs">
            {formatDay(snapshot.dates[0] ?? "")} –{" "}
            {formatDay(snapshot.dates.at(-1) ?? "")}
            {stale && (
              <> · Vercel did not respond to the last refresh, so this may be out of date</>
            )}
          </p>
        )
      }
    </div>

    {
      snapshot === null ? (
        <p>
          Audience analytics could not be loaded right now. Check back soon, or{" "}
          <a href={SPONSORSHIP_CONTACT_URL}>ask us for the numbers</a>.
        </p>
      ) : (
        <SponsorAnalytics snapshot={snapshot} client:load />
      )
    }
  </section>

  <AsciiDivider />

  <section id="sponsors" class="view-container">
    <h2>
      <a href="#sponsors" class="view-container-title">SPONSORS</a>
    </h2>
    {
      tierGroups.map(({ layout, sponsors, tier }) => (
        <div class="space-y-2 pt-2">
          <h3 class="text-muted-foreground">{tier.name}</h3>
          <ul class:list={["grid gap-2", layout.grid]}>
            {sponsors.map((sponsor) => (
              <li>
                <a
                  href={addQueryParams(sponsor.url, UTM_PARAMS)}
                  target="_blank"
                  rel="noopener"
                  title={sponsor.name}
                  class:list={[
                    "border-border hover:bg-muted flex items-center justify-center rounded-lg border p-4 transition-colors",
                    layout.block,
                  ]}
                >
                  <img
                    src={sponsor.logo}
                    alt={sponsor.name}
                    class:list={["w-auto max-w-full object-contain", layout.logo]}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              </li>
            ))}
            <li>
              <a
                href={`#tier-${tier.id}`}
                aria-label={`Take this spot: become a ${tier.name} sponsor`}
                class:list={[
                  "group border-border text-muted-foreground hover:border-foreground hover:text-foreground focus-visible:border-foreground focus-visible:text-foreground flex items-center justify-center rounded-lg border border-dashed transition-colors hover:no-underline",
                  layout.block,
                ]}
              >
                <span class="group-hover:hidden group-focus-visible:hidden">
                  Your logo here
                </span>
                <span class="hidden group-hover:inline group-focus-visible:inline">
                  Take this spot ❤️
                </span>
              </a>
            </li>
          </ul>
        </div>
      ))
    }
  </section>

  <AsciiDivider />

  <section id="tiers" class="view-container">
    <h2>
      <a href="#tiers" class="view-container-title">TIERS</a>
    </h2>
    <p class="text-muted-foreground">
      Monthly subscriptions, cancel anytime. Every tier covers all Shadcn Labs
      projects.
    </p>
    <ul class="space-y-4 pt-2">
      {
        SPONSOR_TIERS.map((tier) => (
          <li
            id={`tier-${tier.id}`}
            class="border-border target:border-foreground scroll-mt-6 space-y-3 rounded-lg border p-4"
          >
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="flex items-center gap-2">
                {tier.name}
                {tier.id === "diamond" && <Badge variant="secondary">recommended</Badge>}
              </h3>
              <p>
                <span class="font-mono text-xl">${tier.price}</span>
                <span class="text-muted-foreground">/mo</span>
              </p>
            </div>
            <ul class="space-y-1">
              {tier.perks.map((perk) => (
                <li class="flex gap-2">
                  <Check size={16} class="text-muted-foreground mt-1 shrink-0" aria-hidden="true" />
                  <span>{perk}</span>
                </li>
              ))}
            </ul>
            <a
              href={sponsorCheckoutUrl(tier)}
              class={buttonVariants({
                className:
                  tier.id === "diamond"
                    ? "hover:text-primary-foreground hover:no-underline"
                    : "text-foreground hover:text-foreground hover:no-underline",
                variant: tier.id === "diamond" ? "default" : "outline",
              })}
            >
              Become a {tier.name} sponsor
              <ArrowRight aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
    <p class="text-muted-foreground pt-2 text-xs">
      Payments are processed by{" "}
      <a href="https://dodopayments.com" target="_blank" rel="noopener">Dodo Payments</a>,
      our merchant of record, which handles billing, sales tax, and invoices. By
      subscribing you agree to our <a href={ROUTES.TERMS}>terms</a>,{" "}
      <a href={ROUTES.REFUNDS}>refund policy</a>, and{" "}
      <a href={ROUTES.PRIVACY}>privacy policy</a>.
    </p>
  </section>

  <AsciiDivider />

  <section id="questions" class="view-container">
    <h2>
      <a href="#questions" class="view-container-title">QUESTIONS</a>
    </h2>
    <p>
      Questions, or need a custom package?{" "}
      <a href={SPONSORSHIP_CONTACT_URL} class="inline-flex items-center gap-1">
        Get in touch
        <ArrowRight size={14} aria-hidden="true" />
      </a>
    </p>
  </section>
</BaseLayout>
