---
import AsciiDivider from "@/components/ascii-divider.astro";
import SponsorCheckout from "@/components/sponsor-checkout.astro";
import SponsorCheckoutSkeleton from "@/components/sponsor-checkout-skeleton.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import type { SubscriptionStatus } from "dodopayments/resources/subscriptions";

// Dodo redirects here after checkout with `?subscription_id=…&status=…`.
// Only the ID is used: the status shown comes from Dodo's API.
export const prerender = false;

const subscriptionId = Astro.url.searchParams.get("subscription_id");
const preview = Astro.url.searchParams.get("preview") as SubscriptionStatus | null;

// Per-customer and changes while a payment settles: never cache.
Astro.response.headers.set("Cache-Control", "private, no-store");

---

<BaseLayout
  title="Sponsorship"
  description="Your Shadcn Labs sponsorship checkout."
>
  <AsciiDivider />

  <SponsorCheckout server:defer subscriptionId={subscriptionId} preview={preview}>
    <section slot="fallback" id="welcome" class="view-container">
      <h2>
        <a href="#welcome" class="view-container-title">Sponsorship</a>
      </h2>
      <div role="status">
        <span class="sr-only">Checking your sponsorship…</span>
        <SponsorCheckoutSkeleton />
      </div>
    </section>
  </SponsorCheckout>
</BaseLayout>
