---
import AsciiDivider from "@/components/ascii-divider.astro";
import IssuesContent from "@/components/issues-content.astro";
import BaseLayout from "@/layouts/base-layout.astro";

export const prerender = true;
---

<BaseLayout
  title="Open Issues"
  description="Every open issue across Shadcn Labs projects — find a repo, pick an issue, and start contributing."
>
  <AsciiDivider />

  <section class="view-container" id="issues">
    <h2>
      <a href="#issues" class="view-container-title">Open issues</a>
    </h2>

    <IssuesContent server:defer>
      <p slot="fallback" role="status">Loading open issues…</p>
    </IssuesContent>
  </section>
</BaseLayout>
