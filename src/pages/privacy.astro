---
import LegalLayout from "@/layouts/legal-layout.astro";
import { LINKS } from "@/constants/links";
import { SITE } from "@/constants/site";
---

<LegalLayout
  id="privacy"
  heading="Privacy policy"
  title="Privacy Policy"
  description="What data shadcn-labs.com collects, why, and who processes it."
  updated="October 6, 2026"
>
  <p>
    This policy covers shadcn-labs.com, operated by {SITE.AUTHOR.NAME} as Shadcn
    Labs. We collect as little as we can and never sell personal data.
  </p>

  <h3>Analytics</h3>
  <p>
    We use <a
      href="https://vercel.com/docs/analytics/privacy-policy"
      target="_blank"
      rel="noopener">Vercel Web Analytics</a
    >, which does not use cookies and reports aggregated, anonymous visit data
    such as pages viewed, referrer, country, browser, and device type. The
    sponsors page shows these aggregated numbers across our projects; it never
    shows data about individual visitors.
  </p>

  <h3>Contact form</h3>
  <p>
    When you use the contact form, your name, email, inquiry type, subject, and
    message are sent to us by email through <a
      href="https://formsubmit.co"
      target="_blank"
      rel="noopener">FormSubmit</a
    >. We use them only to reply to you, and you can opt out of other emails
    from us on the form.
  </p>

  <h3>Hosting and third parties</h3>
  <ul>
    <li>The site is hosted on Vercel, which keeps standard request logs.</li>
    <li>Your light or dark theme choice is stored in your browser only.</li>
    <li>
      The press page embeds third-party videos and posts, which may set their
      own cookies when they load.
    </li>
  </ul>

  <h3>Your rights</h3>
  <p>
    You can ask us to access, correct, or delete the personal data we hold
    about you by emailing <a href={`mailto:${LINKS.EMAIL}`}>{LINKS.EMAIL}</a>.
  </p>
</LegalLayout>
