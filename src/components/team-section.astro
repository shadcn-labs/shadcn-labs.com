---
import { TEAM } from "@/constants/team";
import { UTM_PARAMS } from "@/constants/site";
import { addQueryParams } from "@/lib/url";
---

<section id="team" class="view-container scroll-mt-10">
  <h2>
    <a href="#team" class="text-foreground">TEAM</a>
  </h2>
  <ul class="space-y-1">
    {
      TEAM.map((member) => (
        <li>
          <a target="_blank" href={addQueryParams(member.url, UTM_PARAMS)}>
            {member.name}
          </a>
          <br />
          {member.description}
        </li>
      ))
    }
  </ul>
</section>
