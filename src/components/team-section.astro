---
import { TEAM } from "@/constants/team";
import { ROUTES } from "@/constants/routes";
import { UTM_PARAMS } from "@/constants/site";
import { addQueryParams } from "@/lib/url";
---

<section id="team" class="view-container">
  <h2>
    <a href="#team" class="view-container-title">Team</a>
  </h2>
  <ul class="space-y-3">
    {
      TEAM.map((member) => (
        <li>
          <a class="link" target="_blank" href={addQueryParams(member.url, UTM_PARAMS)}>
            {member.name}
          </a>
          <p class="text-muted-foreground text-sm">{member.description}</p>
        </li>
      ))
    }
  </ul>
  <p class="text-muted-foreground">
    Plus <a class="link-underline" href={ROUTES.CONTRIBUTORS}>the rest of the contributors</a>{" "}
    across the org.
  </p>
</section>
