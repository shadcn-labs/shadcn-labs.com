  }

  document.addEventListener("astro:page-load", () => {
    const trigger = document.querySelector(".brand-context-menu");
    const dialog = document.querySelector("#brand-context-menu-dialog") as HTMLDialogElement;
    if (!trigger || !dialog) {return;}

    trigger.addEventListener("contextmenu", (e) => {
      e.preventDefault();
      dialog.style.left = `${e.clientX}px`;
      dialog.style.top = `${e.clientY}px`;
      dialog.showModal();
    });

    document.addEventListener("click", () => {
      dialog.close();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {dialog.close();}
    });

    dialog.querySelectorAll("[data-action]").forEach((item) => {
      item.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const {action} = (e.currentTarget as HTMLElement).dataset;
        const color = getThemeColor();
        if (action === "copy-logomark") {
          navigator.clipboard.writeText(getLogomarkSVG(color));
        } else if (action === "copy-logotype") {
          navigator.clipboard.writeText(getLogotypeSVG(color));
        }
        dialog.close();
      });
    });
  });
</script>

<style>
  .brand-context-menu {
    display: contents;
  }

  .brand-context-menu-dialog {
    position: fixed;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    overflow: visible;
  }

  .brand-context-menu-dialog::backdrop {
    display: none;
  }

  .brand-context-menu-content {
    min-w-[8rem];
    overflow: hidden;
    border-radius: 0.375rem;
    border: 1px solid var(--border);
    background: var(--background);
    padding: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    box-shadow:
      0 4px 6px -1px rgb(0 0 0 / 0.1),
      0 2px 4px -2px rgb(0 0 0 / 0.1);
  }

  .brand-context-menu-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.375rem 0.5rem;
    border-radius: 0.125rem;
    text-decoration: none;
    color: var(--foreground);
    cursor: pointer;
    border: none;
    background: none;
    font: inherit;
    text-align: start;
  }

  .brand-context-menu-item:hover {
    background: var(--border);
  }

  .brand-context-menu-separator {
    margin: 0.25rem 0;
    height: 1px;
    background: var(--border);
  }
</style>
