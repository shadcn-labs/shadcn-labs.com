---
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<span class:list={["brand-context-menu", className]}>
  <slot />
</span>

<dialog id="brand-context-menu-dialog" class="brand-context-menu-dialog">
  <div class="brand-context-menu-content">
