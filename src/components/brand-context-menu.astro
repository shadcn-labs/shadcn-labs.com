        <path d="M19.237 0c.733 0 1.327.59 1.328 1.318v4.616c0 .728-.595 1.319-1.328 1.319h-3.98c-.732 0-1.326.59-1.326 1.318v3.956c0 .729-.595 1.319-1.327 1.319h-3.98c-.733 0-1.327.59-1.327 1.319v29.67c0 .728.594 1.32 1.327 1.32h3.98c.732 0 1.327.59 1.327 1.318v3.956c0 .728.594 1.318 1.327 1.318h3.98c.732 0 1.326.591 1.326 1.32v4.615c0 .728-.594 1.318-1.327 1.318h-4.643c-.733 0-1.326-.59-1.326-1.318v-3.956c0-.729-.595-1.32-1.328-1.32H7.96c-.733 0-1.326-.59-1.326-1.318v-3.956c0-.728-.595-1.319-1.327-1.319h-3.98A1.324 1.324 0 0 1 0 45.494V14.506c0-.728.594-1.32 1.327-1.32h3.98c.732 0 1.327-.59 1.327-1.318V7.912c0-.728.593-1.318 1.326-1.318h3.98c.733 0 1.328-.591 1.328-1.32V1.318A1.32 1.32 0 0 1 14.594 0zm33.169 0c.733 0 1.326.59 1.326 1.318v3.956c0 .729.595 1.32 1.328 1.32h3.98c.733 0 1.326.59 1.326 1.318v3.956c0 .728.595 1.319 1.327 1.319h3.98c.733 0 1.327.59 1.327 1.319v30.988c0 .728-.594 1.32-1.327 1.32h-3.98c-.732 0-1.327.59-1.327 1.318v3.956c0 .728-.593 1.318-1.326 1.318h-3.98c-.733 0-1.328.591-1.328 1.32v3.956c0 .728-.593 1.318-1.326 1.318h-4.643c-.733 0-1.327-.59-1.328-1.318v-4.616c0-.728.595-1.319 1.328-1.319h3.98c.732 0 1.326-.59 1.326-1.318v-3.956c0-.729.595-1.319 1.328-1.319h3.979c.733 0 1.327-.59 1.327-1.319v-29.67c0-.728-.594-1.32-1.327-1.32h-3.98c-.732 0-1.327-.59-1.327-1.318V8.571c0-.728-.594-1.318-1.327-1.318h-3.98a1.324 1.324 0 0 1-1.327-1.32V1.319A1.324 1.324 0 0 1 47.764 0zm65.713 0q6.554 0 11.166 2.426 4.693 2.425 7.363 6.63 2.751 4.206 3.399 9.624l-8.982.484q-.404-3.315-2.023-5.821a10.7 10.7 0 0 0-4.369-3.963q-2.751-1.455-6.716-1.455-5.016 0-7.93 2.345-2.832 2.263-2.832 6.064 0 2.426 1.133 4.124 1.214 1.617 4.208 2.83 3.075 1.214 8.657 2.588 7.444 1.698 11.814 4.205 4.45 2.426 6.311 5.741 1.862 3.316 1.862 7.52 0 5.096-2.67 8.895-2.59 3.72-7.283 5.741Q126.534 60 120.304 60q-6.877 0-11.976-2.507-5.017-2.506-7.93-6.954Q97.486 46.092 97 40.19l8.981-.566q.567 4.042 2.347 6.873 1.78 2.75 4.775 4.205 3.074 1.374 7.362 1.374 3.722 0 6.311-.89 2.67-.97 4.046-3.071 1.376-2.183 1.376-5.498q0-4.366-2.103-6.387-2.022-2.102-6.635-2.992-4.532-.89-12.704-2.749-3.722-.808-6.312-2.183-2.59-1.374-4.451-3.72-1.78-2.425-1.78-6.387 0-4.124 2.265-7.359 2.265-3.316 5.826-5.014Q101.792 0 107.477 0q6.311 0 10.943 2.183 4.715 2.103 7.203 5.822 2.57 3.638 3.56 8.49l-8.82.485q-.567-3.154-2.265-5.499-1.618-2.426-4.855-3.801-3.155-1.374-7.362-1.374-3.398 0-5.582 1.213-2.103 1.132-2.103 3.315 0 1.699.97 2.831.97 1.133 3.237 1.861 2.265.727 6.473 1.536 6.554 1.213 10.196 2.91 3.64 1.618 5.338 4.044Q133 33.246 133 36.966q0 4.447-2.508 7.682-2.427 3.235-6.554 5.175-4.045 1.86-9.304 1.86" fill="currentColor"/>
      </svg>
      Copy Logotype as SVG
    </button>
    <div class="brand-context-menu-separator"></div>
    <a href="/brand" class="brand-context-menu-item">
      Brand Guidelines
    </a>
    <a href="/shadcn-labs-brand.zip" download class="brand-context-menu-item">
      Download Brand Assets
    </a>
  </div>
</dialog>

<script>
  function getThemeColor() {
    return document.documentElement.classList.contains("dark") ? "#fff" : "#111";
  }

  function getLogomarkSVG(color) {
    return `<svg viewBox="0 0 505 455" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Logomark"><path d="M155 45c0 5.523-4.477 10-10 10h-30c-5.523 0-10 4.477-10 10v30c0 5.523-4.477 10-10 10H65c-5.523 0-10 4.477-10 10v225c0 5.523 4.477 10 10 10h30c5.523 0 10 4.477 10 10v30c0 5.523 4.477 10 10 10h30c5.523 0 10 4.477 10 10v35c0 5.523-4.477 10-10 10h-35c-5.523 0-10-4.477-10-10v-30c0-5.523-4.477-10-10-10H60c-5.523 0-10-4.477-10-10v-30c0-5.523-4.477-10-10-10H10c-5.523 0-10-4.477-10-10V110c0-5.523 4.477-10 10-10h30c5.523 0 10-4.477 10-10V60c0-5.523 4.477-10 10-10h30c5.523 0 10-4.477 10-10V10c0-5.523 4.477-10 10-10h35c5.523 0 10 4.477 10 10zm250-5c0 5.523 4.477 10 10 10h30c5.523 0 10 4.477 10 10v30c0 5.523 4.477 10 10 10h30c5.523 0 10 4.477 10 10v235c0 5.523-4.477 10-10 10h-30c-5.523 0-10 4.477-10 10v30c0 5.523-4.477 10-10 10h-30c-5.523 0-10 4.477-10 10v30c0 5.523-4.477 10-10 10h-35c-5.523 0-10-4.477-10-10v-35c0 5.523 4.477-10 10-10h30c5.523 0 10-4.477 10-10v-30c0 5.523 4.477-10 10-10h30c5.523 0 10-4.477 10-10V115c0-5.523-4.477-10-10-10h-30c-5.523 0-10-4.477-10-10V65c0-5.523-4.477-10-10-10h-30c-5.523 0-10-4.477-10-10V10c0-5.523 4.477-10 10-10h35c5.523 0 10 4.477 10 10z" fill="${color}"/><path d="M305 90c0 5.523 4.477 10 10 10h30c5.523 0 10 4.477 10 10v35c0 5.523-4.477 10-10 10h-35c-5.523 0-10-4.477-10-10v-30c0-5.523-4.477-10-10-10h-75c-5.523 0-10 4.477-10 10v75c0 5.523 4.477 10 10 10h80c5.523 0 10 4.477 10 10v30c0 5.523 4.477 10 10 10h30c5.523 0 10 4.477 10 10v85c0 5.523-4.477 10-10 10h-30c-5.523 0-10 4.477-10 10v30c0 5.523-4.477 10-10 10h-85c-5.523 0-10-4.477-10-10v-30c0-5.523-4.477-10-10-10h-30c-5.523 0-10-4.477-10-10v-35c0 5.523 4.477-10 10-10h35c5.523 0 10 4.477 10 10v30c0 5.523 4.477 10 10 10h75c5.523 0 10-4.477 10-10v-75c0-5.523-4.477-10-10-10h-80c-5.523 0-10-4.477-10-10v-30c0-5.523-4.477-10-10-10h-30c-5.523 0-10-4.477-10-10v-85c0 5.523 4.477-10 10-10h30c5.523 0 10-4.477 10-10V60c0-5.523 4.477-10 10-10h85c5.523 0 10 4.477 10 10z" fill="${color}"/></svg>`;
  }

  function getLogotypeSVG(color) {
    return `<svg viewBox="0 0 554 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Logotype"><path d="M19.237 0c.733 0 1.327.59 1.328 1.318v4.616c0 .728-.595 1.319-1.328 1.319h-3.98c-.732 0-1.326.59-1.326 1.318v3.956c0 .729-.595 1.319-1.327 1.319h-3.98c-.733 0-1.327.59-1.327 1.319v29.67c0 .728.594 1.32 1.327 1.32h3.98c.732 0 1.327.59 1.327 1.318v3.956c0 .728.594 1.318 1.327 1.318h3.98c.732 0 1.326.591 1.326 1.32v4.615c0 .728-.594 1.318-1.327 1.318h-4.643c-.733 0-1.326-.59-1.326-1.318v-3.956c0-.729-.595-1.32-1.328-1.32H7.96c-.733 0-1.326-.59-1.326-1.318v-3.956c0-.728-.595-1.319-1.327-1.319h-3.98A1.324 1.324 0 0 1 0 45.494V14.506c0-.728.594-1.32 1.327-1.32h3.98c.732 0 1.327-.59 1.327-1.318V7.912c0-.728.593-1.318 1.326-1.318h3.98c.733 0 1.328-.591 1.328-1.32V1.318A1.32 1.32 0 0 1 14.594 0zm33.169 0c.733 0 1.326.59 1.326 1.318v3.956c0 .729.595 1.32 1.328 1.32h3.98c.733 0 1.326.59 1.326 1.318v3.956c0 .728.595 1.319 1.327 1.319h3.98c.733 0 1.327.59 1.327 1.319v30.988c0 .728-.594 1.32-1.327 1.32h-3.98c-.732 0-1.327.59-1.327 1.318v3.956c0 .728-.593 1.318-1.326 1.318h-3.98c-.733 0-1.328.591-1.328 1.32v3.956c0 .728-.593 1.318-1.326 1.318h-4.643c-.733 0-1.327-.59-1.328-1.318v-4.616c0-.728.595-1.319 1.328-1.319h3.98c.732 0 1.326-.59 1.326-1.318v-3.956c0-.729.595-1.319 1.328-1.319h3.979c.733 0 1.327-.59 1.327-1.319v-29.67c0-.728-.594-1.32-1.327-1.32h-3.98c-.732 0-1.327-.59-1.327-1.318V8.571c0-.728-.594-1.318-1.327-1.318h-3.98a1.324 1.324 0 0 1-1.327-1.32V1.319A1.324 1.324 0 0 1 47.764 0zm65.713 0q6.554 0 11.166 2.426 4.693 2.425 7.363 6.63 2.751 4.206 3.399 9.624l-8.982.484q-.404-3.315-2.023-5.821a10.7 10.7 0 0 0-4.369-3.963q-2.751-1.455-6.716-1.455-5.016 0-7.93 2.345-2.832 2.263-2.832 6.064 0 2.426 1.133 4.124 1.214 1.617 4.208 2.83 3.075 1.214 8.657 2.588 7.444 1.698 11.814 4.205 4.45 2.426 6.311 5.741 1.862 3.316 1.862 7.52 0 5.096-2.67 8.895-2.59 3.72-7.283 5.741Q126.534 60 120.304 60q-6.877 0-11.976-2.507-5.017-2.506-7.93-6.954Q97.486 46.092 97 40.19l8.981-.56