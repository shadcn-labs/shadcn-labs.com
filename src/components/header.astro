---
import { NAV } from "@/constants/site";

const { pathname } = Astro.url;
---

<header class="view-container pt-10">
  <a href="/" class="text-foreground no-underline hover:text-foreground">
    <h1>SHADCN LABS.</h1>
  </a>
  <div>
    <p class="text-primary">Pushing the limits of the shadcn/ui ecosystem.</p>
    <p class="text-muted-foreground text-[10px]">© Shadcn Labs 2026</p>
  </div>
  <nav class="flex gap-4">
    {
      NAV.map((item) => (
        <a
          href={item.href}
          class:list={[
            "no-underline hover:underline",
            pathname === item.href && "text-foreground",
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
