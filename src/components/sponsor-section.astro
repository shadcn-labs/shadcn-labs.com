---
import { ArrowRight } from "@lucide/astro";
import { ROUTES } from "@/constants/routes";
import { SPONSOR_TIERS } from "@/constants/sponsors";

const startingPrice = Math.min(...SPONSOR_TIERS.map((tier) => tier.price));
---

<section id="sponsor-us" class="view-container">
  <h2>
    <a href="#sponsor-us" class="view-container-title">SPONSOR US</a>
  </h2>
  <p>
    Sponsor the whole ecosystem and get placement across all of our projects.
    Tiers start at <span class="font-mono">${startingPrice}</span>/month.
  </p>
  <p class="text-muted-foreground">
    <a href={ROUTES.SPONSORS} class="inline-flex items-center gap-1">
      See live audience analytics and sponsorship tiers
      <ArrowRight size={14} aria-hidden="true" />
    </a>
  </p>
</section>
