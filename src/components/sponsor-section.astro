---
import { ArrowRight } from "@lucide/astro";
import { ROUTES } from "@/constants/routes";
---

<section id="sponsor-us" class="view-container">
  <h2>
    <a href="#sponsor-us" class="view-container-title">SPONSOR US</a>
  </h2>
  <p>
    Sponsor the entire ecosystem and get your brand in front of developers
    across all our projects, docs, READMEs, and community, all through a
    single sponsorship.
  </p>
  <p class="text-muted-foreground pt-2">
    Want to become a sponsor?{" "}
    <a href={ROUTES.SPONSORS} class="inline-flex items-center gap-1">
      See stats and tiers
      <ArrowRight size={14} aria-hidden="true" />
    </a>
  </p>
</section>
