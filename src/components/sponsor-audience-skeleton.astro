---
import { Skeleton } from "@/components/ui/skeleton";

const projects = [
  { name: "w-20", value: "w-8" },
  { name: "w-28", value: "w-10" },
  { name: "w-24", value: "w-8" },
  { name: "w-16", value: "w-10" },
  { name: "w-24", value: "w-8" },
  { name: "w-20", value: "w-10" },
];

const lists = [
  { rows: ["w-3/4", "w-2/3", "w-4/5", "w-1/2", "w-3/5"], title: "w-24" },
  { rows: ["w-2/3", "w-3/4", "w-1/2", "w-4/5", "w-3/5"], title: "w-20" },
];
---

<div aria-hidden="true" class="space-y-3">
  <div class="flex items-center justify-end">
    <Skeleton className="h-7 w-24" />
  </div>

  <dl class="grid grid-cols-2 gap-4">
    {
      ["w-14", "w-16"].map((label) => (
        <div>
          <dt>
            <Skeleton className={`h-4 ${label}`} />
          </dt>
          <dd class="mt-1 flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-2">
            <Skeleton className="h-8 w-16" />
            <Skeleton className="h-3 w-28 max-w-full" />
          </dd>
        </div>
      ))
    }
  </dl>

  <Skeleton className="h-56 w-full rounded-lg" />

  <div class="space-y-2 pt-3">
    <Skeleton className="h-4 w-20" />
    <ul class="space-y-1">
      {
        projects.map((project) => (
          <li class="flex justify-between gap-4 px-2 py-0.5">
            <Skeleton className={`h-5 ${project.name}`} />
            <Skeleton className={`h-4 ${project.value}`} />
          </li>
        ))
      }
    </ul>
  </div>

  <div class="grid grid-cols-1 gap-x-6 gap-y-6 pt-3 sm:grid-cols-2">
    {
      lists.map((list) => (
        <div class="space-y-2">
          <Skeleton className={`h-4 ${list.title}`} />
          <ul class="space-y-1">
            {list.rows.map((width) => (
              <li class="flex justify-between gap-4">
                <Skeleton className={`h-3.5 ${width}`} />
                <Skeleton className="h-3.5 w-8" />
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="space-y-1.5 pt-2">
    <Skeleton className="h-3 w-full" />
    <Skeleton className="h-3 w-4/5 max-w-md" />
  </div>
</div>
