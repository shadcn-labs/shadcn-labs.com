# Copy to .env and fill in the values. Never commit .env.

# Analytics sources: a JSON array with one entry per team, site, or project.
# Every entry names the env var that holds its own token; there is no shared
# fallback. Vercel projects are discovered from the team. Cloudflare and
# PostHog entries name a project from src/constants/projects.ts.
ANALYTICS_SOURCES=[{"provider":"vercel","teamId":"team_example","tokenEnv":"VERCEL_TOKEN"}]

# One token per source. Vercel needs access to the team and its Web Analytics.
VERCEL_TOKEN=

# Add another Vercel team as a separate source and token:
# VERCEL_SECOND_TEAM_TOKEN=

# Cloudflare Web Analytics token needs Account Analytics: Read.
# CLOUDFLARE_EXAMPLE_TOKEN=

# PostHog personal API key needs query:read.
# POSTHOG_EXAMPLE_TOKEN=

# Full example with every provider, as a single line:
# ANALYTICS_SOURCES=[{"provider":"vercel","teamId":"team_example","tokenEnv":"VERCEL_TOKEN"},{"provider":"cloudflare","project":"example","accountId":"account_id","siteTag":"site_tag","tokenEnv":"CLOUDFLARE_EXAMPLE_TOKEN"},{"provider":"posthog","project":"example","projectId":"12345","host":"https://us.posthog.com","tokenEnv":"POSTHOG_EXAMPLE_TOKEN"}]

# Dodo Payments. Use test_mode locally and live_mode in production.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=

# Optional outside Vercel; used for canonical URLs.
# SITE_URL=https://www.shadcn-labs.com
